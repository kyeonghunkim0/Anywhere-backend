# ============================
# 아무데나(Anywhere) 서버 환경변수
# ============================

# 실행 환경 (development | production)
NODE_ENV="development"

# 서버 포트
PORT=3000

# 데이터베이스 (PostgreSQL)
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/anywhere?schema=public"

# OCI 관리형 PostgreSQL 연결 시 TLS 설정
# 로컬 개발에서는 false로 두세요.
DATABASE_SSL="false"
# OCI 콘솔에서 내려받은 CA 인증서 경로 (DATABASE_SSL=true일 때 필수)
DATABASE_CA_CERT=""

# JWT 시크릿 키 (임의의 긴 문자열)
JWT_SECRET="your-super-secret-jwt-key-change-this"
JWT_EXPIRES_IN="7d"

# 한국관광공사 TourAPI 4.0 서비스키 (인코딩된 키)
TOUR_API_KEY="your-tour-api-service-key"

# 한국관광공사 관광사진갤러리(PhotoGalleryService1) 서비스키 (인코딩된 키)
# 별도 키를 발급받지 않았다면 비워두세요 - TOUR_API_KEY를 그대로 사용합니다.
PHOTO_API_KEY=""

# TourAPI 배치 동기화 크론 스케줄 (기본: 매일 새벽 3시)
SYNC_CRON_SCHEDULE="0 3 * * *"

# Google Sign-In OAuth Client ID (iOS 앱과 동일한 클라이언트여야 idToken 검증이 통과합니다)
GOOGLE_CLIENT_ID="your-google-oauth-client-id.apps.googleusercontent.com"

# Apple Sign In Client ID (앱의 Bundle ID. identityToken의 aud와 일치해야 검증이 통과합니다)
APPLE_CLIENT_ID="com.kimkhuna.Anywhere.AnywhereApp"

# 앱 정보 (최초 실행 시 클라이언트 버전/점검 상태 확인용)
APP_LATEST_VERSION="1.0.0"
APP_MIN_VERSION="1.0.0"
MAINTENANCE_MODE="false"
MAINTENANCE_MESSAGE="서비스 점검 중입니다. 잠시 후 다시 이용해주세요."
