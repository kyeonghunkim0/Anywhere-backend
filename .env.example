# ============================
# 아무데나(Anywhere) 서버 환경변수
# ============================

# 서버 포트
PORT=3000

# 데이터베이스 (로컬 개발: SQLite / 배포: PostgreSQL)
# SQLite (로컬 개발용)
DATABASE_URL="file:./dev.db"
# PostgreSQL (AWS RDS 배포용)
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/anywhere?schema=public"

# JWT 시크릿 키 (임의의 긴 문자열)
JWT_SECRET="your-super-secret-jwt-key-change-this"
JWT_EXPIRES_IN="7d"

# 한국관광공사 TourAPI 4.0 서비스키 (인코딩된 키)
TOUR_API_KEY="your-tour-api-service-key"

# TourAPI 배치 동기화 크론 스케줄 (기본: 매일 새벽 3시)
SYNC_CRON_SCHEDULE="0 3 * * *"
